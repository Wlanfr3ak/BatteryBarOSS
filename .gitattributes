# Zeilenenden: Textdateien werden im Repo mit LF gespeichert und unter
# Windows automatisch als CRLF ausgecheckt.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.pdf   binary
