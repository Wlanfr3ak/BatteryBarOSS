# ---------------------------------------------------------------------------
# BatteryBar OSS - .gitignore
# Rules per AGENTS.md:
#   - secrets/keys are NEVER committed (config/secrets.json)
#   - raw research files are NOT committed (sources listed in docs/RESEARCH.md)
#   - local user overrides and caches are NOT committed
# ---------------------------------------------------------------------------

# --- Secrets & local configuration (never commit) ---
config/secrets.json
config/settings.local.json
config/stats.local.json
config/hp_bios.local.json

# --- Raw research files (sources documented in docs/RESEARCH.md) ---
Recherchen/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Build artifacts (PyInstaller, Inno Setup output) ---
build/
dist/
installer/Output/
*.spec

# --- Logs & runtime data ---
logs/
*.log

# --- Editor/IDE ---
.vscode/
.idea/
*.swp
